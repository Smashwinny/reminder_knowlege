+// Optional, account-scoped analysis API. Never accepts a normal sync token at /mcp.
+// One Node process owns this portable JSON store; multiple replicas need a transactional DB.
+const crypto = require('node:crypto');
+const path = require('node:path');
+const fs = require('node:fs');
+const { readArray, writeArray, StorageError } = require('./safe-storage');
+
+const SCOPES = ['reminder.records.read', 'reminder.analysis.write', 'reminder.learning.write'];
+const KINDS = ['learning', 'non_learning', 'duplicate', 'needs_review', 'blocked', 'non_link'];
+const TYPES = Object.fromEntries(KINDS.map((x, i) => [x, ['学习', '非学习', '重复增补', '证据不足', '环境受阻', '非链接类'][i]]));
+const hash = value => crypto.createHash('sha256').update(value).digest('hex');
+const random = () => crypto.randomBytes(32).toString('base64url');
+// Same source fingerprint as tools/reminder_pipeline.py (Unicode, sorted keys, spaced JSON).
+const sourceHash = task => hash(`{"summary": ${JSON.stringify(task.summary || '')}, "text": ${JSON.stringify(task.text || '')}}`);
+const fail = (status, message) => { const e = new Error(message); e.status = status; throw e; };
+const equal = (a, b) => {
+  const x = Buffer.from(String(a || '')), y = Buffer.from(String(b || ''));
+  return x.length === y.length && crypto.timingSafeEqual(x, y);
+};
+function text(value, name, max = 12000) {
+  if (typeof value !== 'string' || !value.trim() || value.length > max) fail(400, `${name}缺失或过长`);
+  return value.trim();
+}
+function publicUrl(value) {
+  let u; try { u = new URL(value); } catch { fail(400, '来源必须是完整 HTTP(S) URL'); }
+  if (!['http:', 'https:'].includes(u.protocol) || u.username || u.password) fail(400, '来源 URL 含凭据或协议无效');
+  return u.href;
+}
+function canonicalLink(task) {
+  const value = String(task.text || '').trim();
+  if (/\s/.test(value)) return '';
+  let u; try { u = new URL(value); } catch { return ''; }
