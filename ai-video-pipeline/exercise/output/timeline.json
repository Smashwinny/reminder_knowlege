{
  "voice": "zh-CN-YunxiNeural",
  "sentences": [
    {
      "index": 0,
      "text": "物业费到底花在了哪里？我们先看合同里约定的收费构成。",
      "start": 0.0,
      "end": 5.95,
      "dur": 5.95
    },
    {
      "index": 1,
      "text": "第一部分是人员费用，保安、保洁和绿化，通常占物业费的一半以上。",
      "start": 5.95,
      "end": 12.38,
      "dur": 6.43
    },
    {
      "index": 2,
      "text": "第二部分是公共能耗，电梯和水泵的电费，按面积分摊到每一户。",
      "start": 12.38,
      "end": 18.64,
      "dur": 6.26
    },
    {
      "index": 3,
      "text": "核查的办法只有一种：要求物业公示年度收支台账。",
      "start": 18.64,
      "end": 23.85,
      "dur": 5.21
    },
    {
      "index": 4,
      "text": "依据是民法典第九百四十三条，业主有权查阅公开的收费项目。",
      "start": 23.85,
      "end": 30.38,
      "dur": 6.53
    }
  ],
  "total": 30.38
}